# Feishu Bot Configuration
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key

# Baidu Maps
BAIDU_MAP_AUTH_TOKEN=your_baidu_map_auth_token

# AI Model Configuration
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Multi-model auto-switching (optional, JSON array, priority-ordered)
# MODEL_FALLBACKS=[{"base_url":"https://api.siliconflow.cn/v1","api_key":"your_key","model":"deepseek-ai/DeepSeek-V3"}]

# Alpha-ID Configuration (optional)
ALPHA_ID_API_URL=http://localhost:8000
ALPHA_ID_API_KEY=

# Douyin Configuration (optional)
DOUYIN_USERNAME=
DOUYIN_PASSWORD=

# Shopify Configuration (optional)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# Short Drama Platform (optional)
SHORTDRAMAS_API_URL=
SHORTDRAMAS_API_KEY=
SHORTDRAMAS_WEBHOOK_SECRET=

# Application
DEBUG=false

# Database (PostgreSQL recommended, SQLite for local dev)
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/nebula
# SQLite:     sqlite+aiosqlite:///./nebula.db
DATABASE_URL=postgresql+asyncpg://ghost:ghost_secret@localhost:5432/nebula
