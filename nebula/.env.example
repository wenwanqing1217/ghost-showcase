# 飞书机器人配置
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key

# 百度地图 Agent Plan Token
BAIDU_MAP_AUTH_TOKEN=your_baidu_map_auth_token

# AI 模型配置
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 多模型自动切换（可选，JSON 数组，按优先级排列）
# MODEL_FALLBACKS=[{"base_url":"https://api.siliconflow.cn/v1","api_key":"your_key","model":"deepseek-ai/DeepSeek-V3"}]

# Alpha-ID 配置（可选）
ALPHA_ID_API_URL=http://localhost:8000
ALPHA_ID_API_KEY=

# 抖音短剧配置（可选）
DOUYIN_USERNAME=
DOUYIN_PASSWORD=

# Shopify 配置（可选）
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# DS Dashboard 跨服务通信（可选）
DS_API_URL=http://localhost:3004
DS_API_KEY=

# 短剧平台内容预审配置（可选）
SHORTDRAMAS_API_URL=
SHORTDRAMAS_API_KEY=
SHORTDRAMAS_WEBHOOK_SECRET=

# 应用配置
DEBUG=false

# 数据库（PostgreSQL 推荐，SQLite 作为本地开发备选）
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/mindflow_map
# SQLite:     sqlite+aiosqlite:///./mindflow_map.db
DATABASE_URL=postgresql+asyncpg://mw:mw_secret@localhost:5432/mindflow_map
