# ════════════════════════════════════════════════════════════════════
# MW Workspace — 统一环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── 全局 ──
NODE_ENV=production

# ── PostgreSQL（共享实例） ──
DB_USER=mw
DB_PASSWORD=change_me_to_strong_password
DB_NAME=mw
DB_PORT=5432

# ── MindFlow Map (端口 2002) ──
OPENAI_API_KEY=your_deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BAIDU_MAP_AUTH_TOKEN=

# ── DS Dashboard (端口 3004) ──
DEMO_MODE=false
DS_API_KEY=generate_with_openssl_rand_hex_24
DASH_USER=admin
DASH_PASS=change_me_to_strong_password
OPENAI_API_KEY_DS=your_openai_key
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ── AID Alpha-ID (端口 8000) ──
AID_OPENAI_API_KEY=your_key
AUTH_MASTER_KEY=generate_random_hex

# ── MindFlow Web (端口 3000) ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── MindFlow API (端口 3001) ──
MF_OPENAI_API_KEY=your_key
MF_DATABASE_URL=postgresql://mw:mw_secret@localhost:5432/mindflow
