# ════════════════════════════════════════════════════════════════════
# Ghost Workspace — Environment Template
# Copy to .env and fill in: cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── Global ──
NODE_ENV=production

# ── PostgreSQL (shared instance) ──
DB_USER=ghost
DB_PASSWORD=change_me_to_strong_password
DB_NAME=ghost
DB_PORT=5432

# ── Gateway (:18080) ──
GATEWAY_PORT=18080

# ── Nebula — Workflow Engine (:2002) ──
NEBULA_OPENAI_API_KEY=your_key
NEBULA_BASE_URL=https://api.deepseek.com/v1
NEBULA_MODEL=deepseek-chat

# ── Alpha-ID — Identity Layer (:8000) ──
AID_OPENAI_API_KEY=your_key
AUTH_MASTER_KEY=generate_random_hex

# ── Feishu Bot ──
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
BAIDU_MAP_AUTH_TOKEN=

# ── Founder Identity ──
FOUNDER_ALPHA_ID=Alpha-1
FOUNDER_DEVICE_FINGERPRINT=FOUNDER_DEVICE_20250618
