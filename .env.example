# ════════════════════════════════════════════════════════════════════
# Ghost Workspace — 统一环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── 全局 ──
NODE_ENV=production

# ── PostgreSQL（共享实例） ──
DB_USER=mw
DB_PASSWORD=change_me_to_strong_password
DB_NAME=mw
DB_PORT=5432

# ── Ghost Bot（飞书机器人 + TwinBrain） ──
GHOST_ALPHA_ID=Ghost-001
OPENAI_API_KEY=your_deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
BAIDU_MAP_AUTH_TOKEN=

# ── 创始人身份配置 ──
FOUNDER_ALPHA_ID=Alpha-1
FOUNDER_DEVICE_FINGERPRINT=FOUNDER_DEVICE_20250618
# FOUNDER_CODE_HASH=  # 留空则使用默认（sha256("Alpha-1-zx")）

# ── 工作区路径 ──
GHOST_WORKSPACE_PATH=

# ── Nebula (端口 2002) ──
NEBULA_OPENAI_API_KEY=your_key
NEBULA_BASE_URL=https://api.deepseek.com/v1
NEBULA_MODEL=deepseek-chat

# ── DS Dashboard (端口 3004) ──
DEMO_MODE=true
DASH_USER=admin
DASH_PASS=change_me_to_strong_password
DEEPSEEK_API_KEY=your_key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Shoplazza 连接（有值则自动关闭 Demo 模式）
SHOPLAZZA_SHOP_DOMAIN=
SHOPLAZZA_ACCESS_TOKEN=

# ── AID Alpha-ID (端口 8000) ──
AID_OPENAI_API_KEY=your_key
AUTH_MASTER_KEY=generate_random_hex

# ── Ghost Web (端口 3000) ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Ghost API (端口 3001) ──
MF_OPENAI_API_KEY=your_key
MF_DATABASE_URL=postgresql://mw:mw_secret@localhost:5432/mindflow
