# Ghost Gateway 统一配置（示例 — 复制为 .env 使用）
# 注意：Docker Compose 中由 environment 段覆盖服务间地址，此文件用于本地直接运行
# 后端服务地址
ALPHAID_URL=http://localhost:8002
DS_URL=http://localhost:3004
NEBULA_URL=http://localhost:2002

# 默认身份
DEFAULT_ALPHA_ID=Alpha-001

# 网关端口
GATEWAY_PORT=18080

# Redis / EventBus
REDIS_URL=redis://localhost:6379
EVENT_STREAM_PREFIX=alphaid:events

# 用 127.0.0.1 而不是 localhost（避免 IPv6 连接失败）
FLOW_URL=http://127.0.0.1:3036
