# =============================================================================
# Feishu Bot — 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被追踪）
# =============================================================================

# ── 飞书凭证（必填，从飞书开放平台获取）──
# https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 已知会话 ID（可选，逗号分隔多个 chat_id）──
# 仅这些 chat 收到消息时才会响应，留空表示响应所有
KNOWN_CHAT_IDS=

# ── 默认代码执行后端（atomcode=免费 / zcode / codex / echo）──
DEFAULT_BACKEND=echo

# ── 代码运行工作目录（让后端能看到你的项目文件）──
CODE_RUNNER_DIR=/app/workspace

# ── 自定义后端路径（可选）──
# CUSTOM_BACKEND=
# ZCODE_PATH=
# CODEX_PATH=atomcode

# ── 速率限制（每分钟每用户最大请求数）──
RATE_LIMIT_PER_MINUTE=20

# ── Codex API 子服务（可选，由 codex_api.py 启动）──
# CODEX_API_KEY=
# CODEX_API_HOST=127.0.0.1
# CODEX_API_PORT=21345
# CODEX_API_CORS_ORIGIN=http://localhost:21345
# CODEX_MAX_CONCURRENT=3

# ── Gateway 回调地址（容器内访问 gateway 服务）──
GATEWAY_URL=http://gateway:18080

# ── Redis Streams 消费者（feishu_consumer.py 用）──
REDIS_URL=redis://redis:6379
EVENT_STREAM_PREFIX=alphaid:ecom
FEISHU_CONSUMER_GROUP=feishu-notifiers
FEISHU_CONSUMER_NAME=feishu-consumer-1
FEISHU_BLOCK_TIMEOUT=5000
FEISHU_BATCH_SIZE=10
