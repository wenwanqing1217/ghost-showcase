# ════════════════════════════════════════════════════════════════════
# Ghost Workspace — Caddy Production Config (Real Domain + Auto HTTPS)
# ════════════════════════════════════════════════════════════════════
# Usage:
#   1. Replace all example.com with your real domain
#   2. Ensure DNS resolves to your server IP
#   3. caddy run --config Caddyfile.production
#
# Auto features:
#   - Let's Encrypt auto TLS certificate provisioning/renewal
#   - HTTP → HTTPS auto redirect
#   - HTTP/3 (QUIC) support
#   - Brotli + Gzip compression
# ════════════════════════════════════════════════════════════════════

# ── Main entry ──
ghost.example.com {
    encode gzip

    # Security headers
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.stripe.com https://api.deepseek.com https://api.groq.com"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
        -Server
    }

    # Health check
    handle /health {
        respond "OK" 200
    }

    # Gateway — Unified API entry point
    handle_path /api/* {
        reverse_proxy gateway:18080
    }

    # Default → Gateway
    reverse_proxy gateway:18080
}

# ── Sub-domain routing ──
nebula.example.com {
    encode gzip
    reverse_proxy nebula:2002
}

aid.example.com {
    encode gzip
    reverse_proxy alphaid:8000
}

# ── Root domain redirect ──
example.com {
    redir https://ghost.example.com permanent
}

# ── www redirect ──
www.ghost.example.com {
    redir https://ghost.example.com permanent
}
www.example.com {
    redir https://ghost.example.com permanent
}
