# ════════════════════════════════════════════════════════════════════
# Ghost Workspace — Caddy Production Config
# ════════════════════════════════════════════════════════════════════
# Auto HTTPS (Let's Encrypt), reverse proxy to internal services
# Usage: caddy run --config Caddyfile
#
# Uncomment and set your domain to enable production TLS
# ════════════════════════════════════════════════════════════════════

# ---------- Production domain (uncomment & set your domain) ----------
# ghost.example.com {
#     encode gzip
#
#     # Security headers
#     header {
#         Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.stripe.com https://api.deepseek.com https://api.groq.com"
#         Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
#         X-Frame-Options "DENY"
#         X-Content-Type-Options "nosniff"
#         X-XSS-Protection "1; mode=block"
#         Referrer-Policy "strict-origin-when-cross-origin"
#         Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
#         -Server
#     }
#
#     # Gateway — Unified API entry point
#     handle_path /api/* {
#         reverse_proxy gateway:18080
#     }
#
#     # Default → Gateway
#     reverse_proxy gateway:18080
# }
#
# # Sub-domains (optional, direct service access)
# nebula.example.com {
#     encode gzip
#     reverse_proxy nebula:2002
# }
#
# aid.example.com {
#     encode gzip
#     reverse_proxy alphaid:8000
# }

# ---------- Local development / self-signed (no domain needed) ----------
:80 {
    encode gzip

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
        -Server
    }

    # Health check
    handle /health {
        respond "OK" 200
    }

    # Gateway — Unified API entry point (priority match)
    handle_path /api/gateway/* {
        uri strip_prefix /api/gateway
        reverse_proxy gateway:18080
    }

    # Alpha-ID API
    handle_path /api/aid/* {
        uri strip_prefix /api/aid
        reverse_proxy alphaid:8000
    }

    # Nebula Workflow Engine
    handle_path /api/nebula/* {
        reverse_proxy nebula:2002
    }

    # Default → Gateway
    reverse_proxy gateway:18080
}
