{
  "manifest_version": 3,
  "name": "Ghost Capture — 豆包记忆桥接",
  "version": "1.0.0",
  "description": "自动捕获豆包网页版对话，传入 Ghost 知识体系",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.doubao.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghost Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.doubao.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
