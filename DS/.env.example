# ── Ghost DS 电商看板 环境变量模板 ──
# 复制为 .env 并填写实际值：cp .env.example .env

# ── 应用 ──
NODE_ENV=development
PORT=3000
DEMO_MODE=true

# ── 看板登录（基础认证） ──
DASH_USER=admin
DASH_PASS=change_me_to_strong_password

# ── 数据库 ──
DATABASE_URL=postgresql://ghost:ghost_secret@localhost:5432/ds?schema=public

# ── Shoplazza（有值则关闭 Demo 模式） ──
SHOPLAZZA_SHOP_DOMAIN=
SHOPLAZZA_ACCESS_TOKEN=

# ── AI 文案生成（DeepSeek） ──
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ── Webhook（Shoplazza 实时推送） ──
# 在 Shoplazza 后台配置 Webhook 时设置的密钥，用于验证回调签名
SHOPLAZZA_WEBHOOK_SECRET=

# ── 定时同步（Cron） ──
# 保护 /api/cron/sync 端点的 Bearer Token（建议设置强随机值）
# 留空则不验证（不推荐生产环境）
CRON_SECRET=
