// Ghost DS — 本地 SQLite 开发用 Schema
// 使用方式：cp schema.local.prisma schema.prisma && npx prisma db push
// 生产环境请使用 schema.prisma（PostgreSQL）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// 店铺连接配置（一个店铺一条记录）
model Shop {
  id         String   @id @default(cuid())
  name       String   @default("我的店铺")
  domain     String
  accessToken String
  platform   String   @default("shoplazza")
  alphaId    String?
  active     Boolean  @default(true)
  tenantId   String   @default("default")
  storeMode  String?  @default("marketplace")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]
  orders   Order[]
  syncLogs SyncLog[]

  @@unique([domain])
  @@index([alphaId])
  @@index([tenantId])
}

/// 商品数据
model Product {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalId   String
  title        String
  description  String?
  price        Float    @default(0)
  comparePrice Float?
  currency     String   @default("USD")
  inventory    Int      @default(0)
  images       String   @default("[]")
  status       String   @default("active")
  rawData      String?
  lastSyncedAt DateTime @default(now())
  tenantId     String   @default("default")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, externalId])
  @@index([shopId, status])
  @@index([lastSyncedAt])
  @@index([tenantId])
}

/// 订单数据
model Order {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalId    String
  orderNo       String
  amount        Float    @default(0)
  currency      String   @default("USD")
  status        String   @default("pending")
  customerName  String?
  customerEmail String?
  itemCount     Int      @default(0)
  paidAt        DateTime?
  fulfilledAt   DateTime?
  trackingNumber String?
  trackingCompany String?
  refundedAt    DateTime?
  rawData       String?
  tenantId      String   @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, externalId])
  @@index([shopId, status])
  @@index([createdAt])
  @@index([paidAt])
  @@index([tenantId])
}

/// 同步日志
model SyncLog {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entity     String
  action     String
  status     String   @default("running")
  count      Int      @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  tenantId   String   @default("default")

  @@index([shopId, entity, startedAt])
  @@index([tenantId])
}
