// Ghost DS — 生产环境 Schema（PostgreSQL）
// 此文件为 schema.prisma 的 PostgreSQL 备份
// Docker Compose 部署时使用此 schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 店铺连接配置
model Shop {
  id        String   @id @default(cuid())
  name      String   @default("我的店铺")
  domain    String
  accessToken String
  platform  String   @default("shoplazza")
  alphaId   String?
  tenantId  String   @default("default")
  storeMode String   @default("marketplace")  // 'marketplace' | 'independent' | 'both'
  settings  Json?    @default("{}")           // 独立站装修配置、自定义域名等
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
  syncLogs SyncLog[]

  @@unique([domain])
  @@index([alphaId])
  @@index([tenantId])
  @@index([storeMode])
}

/// 商品数据
model Product {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tenantId     String   @default("default")
  externalId   String
  title        String
  description  String?  @db.Text
  price        Float    @default(0)
  comparePrice Float?
  currency     String   @default("USD")
  inventory    Int      @default(0)
  images       Json     @default("[]")
  status       String   @default("active")
  rawData      Json?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, externalId])
  @@index([shopId, status])
  @@index([tenantId, status])
  @@index([lastSyncedAt])
}

/// 订单数据
model Order {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tenantId      String   @default("default")
  externalId    String
  orderNo       String
  amount        Float    @default(0)
  currency      String   @default("USD")
  status        String   @default("pending")
  customerName  String?
  customerEmail String?
  itemCount     Int      @default(0)
  paidAt          DateTime?
  fulfilledAt     DateTime?
  trackingNumber  String?
  trackingCompany String?
  refundedAt      DateTime?
  rawData       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, externalId])
  @@index([shopId, status])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([paidAt])
}

/// 同步日志
model SyncLog {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tenantId   String   @default("default")
  entity     String
  action     String
  status     String   @default("running")
  count      Int      @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([shopId, entity, startedAt])
  @@index([tenantId, startedAt])
}

/// 租户映射：将 Alpha-ID 用户映射到 tenant_id 以实现数据隔离
model TenantMapping {
  id         String   @id @default(cuid())
  alphaId    String   @unique @map("alpha_id")
  tenantId   String   @default("default") @db.Text
  plan       String?  @default("free") // "free" | "pro" | "enterprise"
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@map("TenantMapping")
}

/// AI 生成内容（视频/游戏）
model Content {
  id           String   @id @default(cuid())
  contentType  String   @default("video") // "video" | "game"
  title        String
  description  String?  @db.Text
  status       String   @default("generating") // "generating" | "completed" | "failed"
  taskId       String?

  // 视频字段
  videoUrl     String?
  thumbnailUrl String?
  duration     Int?     // seconds
  script       String?  @db.Text
  aspectRatio  String?  // "9:16" | "16:9" | "1:1"

  // 游戏字段
  gameUrl      String?
  gameType     String?  // "space_shooter" | "platformer" | etc.
  theme        String?  // "cyberpunk" | "japanese_anime" | etc.

  tags         Json     @default("[]") // JSON array
  metadata     Json?
  tenantId     String   @default("default")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([contentType])
  @@index([status])
  @@index([createdAt])
}
