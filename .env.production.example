# ════════════════════════════════════════════════════════════════════
# Ghost Workspace — Production Environment Template
# ════════════════════════════════════════════════════════════════════
# Usage:
#   1. cp .env.production.example .env.production
#   2. Replace all CHANGE_ME values
#   3. docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ════════════════════════════════════════════════════════════════════

# ── Database (must change) ──
DB_USER=ghost
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
DB_NAME=ghost
DB_PORT=5432

# ── Gateway (:18080) ──
GATEWAY_PORT=18080

# ── Nebula — Workflow Engine (:2002) ──
NEBULA_OPENAI_API_KEY=your_deepseek_key
NEBULA_BASE_URL=https://api.deepseek.com/v1
NEBULA_MODEL=deepseek-chat
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
BAIDU_MAP_AUTH_TOKEN=

# ── Alpha-ID — Identity Layer (:8000) ──
AID_OPENAI_API_KEY=your_key
AID_AUTH_MASTER_KEY=CHANGE_ME_RANDOM_HEX_64_CHARS
AID_LOG_LEVEL=info

# ── Caddy / TLS (production domain) ──
# DOMAIN_NEBULA=nebula.example.com
# DOMAIN_AID=aid.example.com
# CADDY_ADMIN_EMAIL=admin@example.com
