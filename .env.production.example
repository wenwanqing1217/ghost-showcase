# ════════════════════════════════════════════════════════════════════
# MW Workspace — 生产环境变量模板
# ════════════════════════════════════════════════════════════════════
# 使用方法:
#   1. cp .env.production.example .env.production
#   2. 修改所有标记为 "CHANGE_ME" 的值
#   3. docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ════════════════════════════════════════════════════════════════════

# ── 数据库（必须修改） ──
DB_USER=mw
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
DB_NAME=mw
DB_PORT=5432

# ── 服务间认证（必须修改，使用相同值） ──
DS_API_KEY=CHANGE_ME_RANDOM_HEX_48_CHARS

# ── MindFlow Map ──
OPENAI_API_KEY=your_deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
BAIDU_MAP_AUTH_TOKEN=

# ── DS Dashboard ──
DEMO_MODE=false
DASH_USER=admin
DASH_PASS=CHANGE_ME_STRONG_PASSWORD
OPENAI_API_KEY_DS=your_openai_key
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ── AID Alpha-ID ──
AID_OPENAI_API_KEY=your_key
AID_AUTH_MASTER_KEY=CHANGE_ME_RANDOM_HEX_64_CHARS
AID_LOG_LEVEL=info

# ── Caddy / TLS（生产域名） ──
# DOMAIN_MAP=map.example.com
# DOMAIN_DS=ds.example.com
# DOMAIN_AID=aid.example.com
# CADDY_ADMIN_EMAIL=admin@example.com
